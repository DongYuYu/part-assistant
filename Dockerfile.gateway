# Gateway image: only the web packages and three source files (no torch, no retrieval).
# Same base and uv as the app image (Dockerfile).
#
#   docker compose build gateway
#   docker compose run --rm gateway add-key alice     # prints the key once
#   docker compose up -d gateway                      # http://127.0.0.1:8100

FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1

# Non-root user; /data holds the key and usage database (a volume).
RUN useradd --create-home --uid 1000 app \
 && mkdir -p /app /data \
 && chown -R app:app /app /data
WORKDIR /app
USER app

# Only the "gateway" dependency group, at the versions locked in uv.lock.
RUN --mount=type=cache,target=/home/app/.cache/uv,uid=1000 \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --only-group gateway --no-install-project

# Not the whole project: the gateway imports only these (tests/test_gateway.py checks it).
COPY --chown=app:app src/part_assistant/__init__.py src/part_assistant/prices.py \
     src/part_assistant/gateway.py /app/src/part_assistant/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app/src \
    PART_ASSISTANT_GATEWAY_DB=/data/gateway.db

EXPOSE 8100
ENTRYPOINT ["python", "-m", "part_assistant.gateway"]
# 0.0.0.0 inside the container; compose publishes it on the host's 127.0.0.1 only.
CMD ["serve", "--host", "0.0.0.0"]
